{
  "name": "dsh-plugin-file-system",
  "version": "0.1.0",
  "description": "文件系统文件查看器：在 DSH 对话页签行新增「文件系统」页签，左侧宿主文件树 + 右侧查看/编辑器",
  "type": "module",
  "license": "MIT",
  "main": "lib/host/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint . --config .oxlintrc.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reportOnFailure=true; cov=$?; node scripts/verify-coverage-scope.mjs; scope=$?; if [ $cov -ne 0 ] || [ $scope -ne 0 ]; then exit 1; fi",
    "build": "tsc -b tsconfig.host.json && tsdown && node scripts/normalize-client-banner.mjs && node scripts/verify-client-banner.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "file-system",
    "fs",
    "file-viewer"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-web-react": "*",
    "@deepseek-ai/dsh-llm": "*",
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-web-react": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
